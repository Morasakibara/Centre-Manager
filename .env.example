# ---------------------------------------------------------------------------
# Centre Manager - configuration locale
# Copier ce fichier en .env puis adapter les valeurs.
# Ne jamais versionner le fichier .env.
# ---------------------------------------------------------------------------

APP_NAME="Centre Manager"
APP_ENV=local
APP_DEBUG=false
APP_URL="http://localhost/centre-manager/public"

# Fuseau horaire et devise
APP_TIMEZONE=Africa/Douala
APP_DEVISE=XAF

# --- Base de donnees -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=centre_manager
DB_USERNAME=centre_manager
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Identite du centre (rapports et recus) --------------------------------
CENTRE_NOM="PharaonAcademia"
CENTRE_ADRESSE="Avenue de la Formation, Douala"
CENTRE_TELEPHONE="+237 6 00 00 00 00"
CENTRE_EMAIL="contact@centre-exemple.local"

# --- Matricules ------------------------------------------------------------
MATRICULE_PREFIXE=CF
MATRICULE_FORMAT=%s-%d-%04d

# --- Securite --------------------------------------------------------------
# Duree d'inactivite de la session en minutes
SESSION_LIFETIME=60
# Nombre d'echecs avant blocage temporaire et duree du blocage (minutes)
LOGIN_MAX_TENTATIVES=5
LOGIN_BLOCAGE_MINUTES=15
# Forcer HTTPS pour les cookies de session (1 si HTTPS)
SESSION_SECURE=0

# --- Sauvegardes -----------------------------------------------------------
# Chemin absolu vers mysqldump (laisser vide pour detection automatique)
MYSQLDUMP_PATH=
BACKUP_RETENTION=14
